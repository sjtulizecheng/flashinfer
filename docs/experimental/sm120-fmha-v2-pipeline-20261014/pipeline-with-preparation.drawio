        <mxCell id="c3044" value="黄色 prepare：整个准备阶段；彩色细条：一个 CTA 的 warp 0；灰色背景：Attention 内未展示的工作。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=20;align=center;verticalAlign=middle;spacing=6;align=left;spacing=0;fontColor=#243247;fontStyle=0;">
          <mxGeometry x="36" y="2130" width="2088" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c3045" value="globaltimer 可跨 kernel / SM 对齐；原 clock64 仅用于 CTA 内周期。不能按固定 GPU 频率把旧单测毫秒数拼到 clock64 上。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=19;align=center;verticalAlign=middle;spacing=6;align=left;spacing=0;fontColor=#56677c;fontStyle=0;">
          <mxGeometry x="36" y="2175" width="2088" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3046" value="这是带打点的观测样本；性能收益仍以上方无打点实测为准。异步框是 issue→wait 窗口，不是 DMA 精确时长。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=19;align=center;verticalAlign=middle;spacing=6;align=left;spacing=0;fontColor=#56677c;fontStyle=0;">
          <mxGeometry x="36" y="2220" width="2088" height="42" as="geometry" />
