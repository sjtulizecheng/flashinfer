        </mxCell>
        <mxCell id="c152" value="共享内存 / CTA&#10;64 KiB → 48 KiB + 16 B&#10;共享内存允许驻留：1 → 2 CTA / SM" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfecf5;strokeColor=#348ac1;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=18;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=10;strokeWidth=1;">
          <mxGeometry x="36" y="1482" width="674" height="112" as="geometry" />
        </mxCell>
        <mxCell id="c153" value="无打点 NCU 实测&#10;占用率 8.33% → 16.56%&#10;local load / store 均为 0" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ddefe8;strokeColor=#299c71;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=18;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=10;strokeWidth=1;">
