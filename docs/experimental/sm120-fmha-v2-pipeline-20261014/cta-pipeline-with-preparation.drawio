        </mxCell>
        <mxCell id="c154" value="观测限制&#10;打点使整核耗时增加约 3.5%～11.0%&#10;阶段占比不能直接作为单项优化收益" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fbf2e3;strokeColor=#e5af51;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=18;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=10;strokeWidth=1;">
