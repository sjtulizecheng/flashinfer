        </mxCell>
        <mxCell id="c155" value="编辑提示：色块是独立对象；悬停查看周期，右键“编辑数据”查看阶段属性。缩放时间条不会自动重算测量数值。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=16;align=center;verticalAlign=middle;spacing=6;align=left;spacing=0;fontColor=#56677c;fontStyle=0;">
          <mxGeometry x="36" y="1613" width="2088" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c156" value="准备与 Attention 顺序执行；TMA overlap 在 Attention 内。组件单测不能相加替代连跑。ms 为无打点全核耗时，cycles 为单 CTA 打点样本。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#243247;fontFamily=Noto Sans CJK SC,Noto Sans SC,Microsoft YaHei,PingFang SC,Arial;fontSize=17;align=center;verticalAlign=middle;spacing=6;align=left;spacing=0;fontColor=#56677c;fontStyle=0;">
